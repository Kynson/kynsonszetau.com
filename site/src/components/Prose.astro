{/* Prose styles */}
<style>
  /* Adapted from tailwindcss typography plugin. LICENSE: MIT https://github.com/tailwindlabs/tailwindcss-typography/blob/main/LICENSE */
  .prose :global(h1:not(:is(.not-prose, .not-prose *))) {
    font-size: 2.25rem;
    margin-bottom: 0.8888rem;
  }

  .prose :global(h2:not(:is(.not-prose, .not-prose *))) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3:not(:is(.not-prose, .not-prose *))) {
    font-size: 1.25rem;
    margin-top: 1.6rem;
    margin-bottom: 0.6rem;
  }

  .prose :global(p:not(:is(.not-prose, .not-prose *))) {
    margin: 1.25rem 0;
  }

  .prose :global(:is(ol, ul):not(:is(.not-prose, .not-prose *))) {
    margin: 1.25rem 0;
    padding-inline-start: 1.625rem;
  }

  .prose :global(ol:not(:is(.not-prose, .not-prose *))) {
    list-style-type: decimal;
  }

  .prose :global(ul:not(:is(.not-prose, .not-prose *))) {
    list-style-type: disc;
  }

  .prose :global(li:not(:is(.not-prose, .not-prose *))) {
    margin: 0.5rem 0;

    &::marker {
      color: var(--color-gray-500);
    }
  }

  .prose
    :global(
      :is(ol, ul):not(:is(.not-prose, .not-prose *))
        > li:not(:is(.not-prose, .not-prose *))
    ) {
    padding-inline-start: 0.375rem;
  }

  .prose
    :global(
      li:not(:is(.not-prose, .not-prose *))
        > p:not(:is(.not-prose, .not-prose *))
    ) {
    margin: 0;
  }

  .prose :global(h2:not(:is(.not-prose, .not-prose *)) + *) {
    margin-top: 0;
  }

  .prose :global(a:not(:is(.not-prose, .not-prose *))) {
    font-weight: 500;

    &:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-blue-300);
      text-underline-offset: 4px;
    }
  }
</style>

{/* Prose content */}
<div class="prose max-w-prose">
  <slot />
</div>
