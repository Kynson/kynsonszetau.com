---
import { Font, fontData } from 'astro:assets';

interface Props {
  title?: string;
  'font-variables'?: (keyof typeof fontData)[];
}

const { title = 'Kynson Szetau', 'font-variables': fontVariables = [] } =
  Astro.props;
---

{/* Head content */}

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap-index.xml" />

<meta name="generator" content={Astro.generator} />
<meta name="cononial" content={new URL(Astro.url.pathname, Astro.site)} />
<meta
  name="description"
  content="The personal site of Kynson Szetau, a self taught developer from Hong Kong."
/>

{
  fontVariables.map((variable) => {
    return <Font cssVariable={variable} />;
  })
}

<title>{title}</title>
