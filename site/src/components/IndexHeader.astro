---
import SectionNavigation from '@components/SectionNavigation.astro';

import Logo from '@assets/logo.svg';
import GithubLogo from '@assets/github-logo.svg';

interface Props {
  'section-count': number;
}

const { 'section-count': sectionCount } = Astro.props;
---

{
  /*
   * Navigation content
   * Note: This component is not standalone and is context-dependent
   **/
}
<Logo class="w-14" />
<SectionNavigation section-count={sectionCount} />
{
  /*
   * If wide and tall enough => vertical and take only one row, hence flex (tall:md:flex)
   * If wide enough but not tall enough => vertical and take two rows, hence subgrid (md:flex). SectionNavigation should hide itself.
   * If not, then flex
   */
}
<div
  class="flex gap-4 items-center justify-end ml-auto md:ml-0 md:row-span-2 md:grid md:grid-rows-subgrid md:justify-items-center tall:md:row-span-1 tall:md:flex tall:md:flex-col"
>
  <nav class="flex gap-3 md:sideways-lr" aria-label="site-navigation">
    <a href="/meta" class="decorated-link">meta</a>
    <a href="https://blog.kynsonszetau.com" class="decorated-link">blog</a>
  </nav>
  <a href="https://github.com/Kynson" class="md:self-end tall:md:mt-4">
    <title>Github Logo</title>
    <GithubLogo class="size-7" />
  </a>
</div>
