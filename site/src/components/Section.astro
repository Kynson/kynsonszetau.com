---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  title?: string;
}

const {
  title,
  id = title?.toLowerCase().replaceAll(' ', '-'),
  ...attributes
} = Astro.props;
---

{/* Section content */}
<section {id} {...attributes}>
  <h2>{title}</h2>
  <slot />
</section>
