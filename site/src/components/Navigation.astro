---
import GithubLogo from '../assets/github-logo.svg';
---

{
  /*
   * Navigation content
   * Note: This component is not standalone and is context-dependent
   **/
}
{
  /*
   * If wide and tall enough => vertical and take only one row, hence flex (tall:md:flex)
   * If wide enough but not tall enough => vertical and take two rows, hence subgrid (md:flex). SectionNavigation should hide itself.
   * If not, then flex
   */
}
<nav
  class="flex gap-4 items-center justify-end md:row-span-2 md:grid md:grid-rows-subgrid md:justify-items-center tall:md:row-span-1 tall:md:flex tall:md:flex-col"
  aria-label="external-navigation"
>
  <div class="flex gap-3 md:flex-col">
    <a href="/meta" class="md:sideways-lr decorated-link">meta</a>
    <a
      href="https://blog.kynsonszetau.com"
      class="md:sideways-lr decorated-link">blog</a
    >
  </div>
  <a href="https://github.com/Kynson" class="md:self-end tall:md:mt-4">
    <title>Github Logo</title>
    <GithubLogo class="size-7" />
  </a>
</nav>
