---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'textarea'> {
  label: string;
  // Note: While it is more appropriate for this to be a client-side dynamic properity,
  // it is not necessary for this project and we can minimize the amount of JavaScript
  'error-message'?: string;
}

const {
  label,
  class: clazz = '',
  ['error-message']: errorMessage = '',
  required,
  ...attributes
} = Astro.props;
---

<label class:list={['inline-flex flex-col gap-2', clazz]}>
  <span>{label}{required ? '*' : ''}</span>
  <textarea
    class="peer rounded-lg bg-gray-900 transition-safe-all appearance-none border border-gray-500 px-3 py-2 leading-6 mb-5 focus:border-blue-50 focus:outline-2 focus:outline-blue-300/50 focus:outline-offset-2 user-invalid:mb-0 user-invalid:border-red-400"
    name={label.toLowerCase()}
    {required}
    {...attributes}></textarea>
  <span class="hidden leading-3 text-xs text-red-400 peer-user-invalid:block"
    >{errorMessage}</span
  >
</label>
