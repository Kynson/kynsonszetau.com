---
import IndexLayout from '../layouts/IndexLayout.astro';

import Header from '@components/index/Header.astro';
import Section from '@components/index/Section.astro';
import SectionContentFallback from '@components/index/SectionContentFallback.astro';

import Hero from '@content/sections/Hero.astro';
import About from '@content/sections/About.astro';
import Projects from '@content/sections/Projects.astro';
import Contact from '@content/sections/Contact.astro';

const SECTION_COUNT = 4;
---

<IndexLayout>
  <Header slot="header" section-count={SECTION_COUNT} />
  <Section id="hero" with-header={false} class="mb-12">
    <Hero />
  </Section>
  <Section section-number="02" title="About" class="mb-12 py-5">
    <About server:defer>
      <SectionContentFallback slot="fallback" section="About" />
    </About>
  </Section>
  <Section section-number="03" title="Projects" class="mb-12 py-5">
    <Projects server:defer>
      <SectionContentFallback slot="fallback" section="Projects" />
    </Projects>
  </Section>
  <Section section-number="04" title="Contact" class="py-5">
    <Contact />
  </Section>
</IndexLayout>
