---
import BaseLayout from './BaseLayout.astro';
---

{/* MainLayout content */}
<BaseLayout
  closing-remarks="That's it! Thanks for visiting!"
  font-variables={['--font-montserrat', '--font-fira-code']}
  html-class="scroll-smooth"
  main-class="justify-self-center md:scroll-smooth md:overflow-y-scroll"
>
  {/* Transfer the slotted element to BaseLayout */}
  <slot name="header" slot="header" />
  <slot />
</BaseLayout>
