---
import BaseLayout from './BaseLayout.astro';

const NAVIGATION_LINKS = {
  home: '/',
  more: '/more'
};
---

{/* MetaLayout content */}
<BaseLayout
  title="Meta | Kynson Szetau"
  closing-remarks="That's it! Thanks for visiting!"
  font-variables={['--font-montserrat']}
  body-class="gap-y-8 md:gap-y-0"
  main-class="md:pt-10 md:overflow-y-scroll"
  header-navigation-links={NAVIGATION_LINKS}
>
  <slot />
</BaseLayout>
