---
import BaseLayout from './BaseLayout.astro';

const NAVIGATION_LINKS = {
  home: '/',
  meta: '/meta'
};
---

<BaseLayout
  title="404 Not Found"
  font-variables={['--font-montserrat']}
  closing-remarks="Don't get lost again!"
  body-class="gap-y-8 md:gap-y-0"
  main-class="md:pt-10 h-full flex flex-col"
  header-navigation-links={NAVIGATION_LINKS}
>
  <slot />
</BaseLayout>
