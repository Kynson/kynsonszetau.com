---
import type { fontData } from 'astro:assets';

import '../styles/global.css';

interface Props {
  'closing-remarks': string;
  'font-variables'?: (keyof typeof fontData)[];
  title?: string;
  'html-class'?: string;
  'body-class'?: string;
  'header-class'?: string;
  'main-class'?: string;
}

import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';

const {
  'closing-remarks': closingRemarks,
  title,
  'font-variables': fontVariables,
  'html-class': htmlClass,
  'body-class': bodyClass,
  'header-class': headerClass,
  'main-class': mainClass
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="bg-gray-950 text-blue-50 min-h-dvh"
  class:list={htmlClass}
>
  <head>
    <Head {title} font-variables={fontVariables} />
  </head>
  <body class:list={['min-h-dvh', bodyClass]}>
    <header class={headerClass}>
      <slot name="header" />
    </header>
    <main class={mainClass}>
      <slot />
      {
        /* Putting Footer in main as there is closing remarks that related to the content in main */
      }
      <Footer closing-remarks={closingRemarks} />
    </main>
  </body>
</html>
