---
import ShadowLogo from '@assets/shadow-logo.svg';
---

{/* Hero styles */}
<style>
  :root {
    --rows-template: 1fr auto 1fr;
  }

  @keyframes typing {
    from {
      width: calc(var(--typewriter-animation-start) * 1ch + 2px);
    }
    to {
      width: calc(var(--typewriter-animation-end) * 1ch + 2px);
    }
  }

  @keyframes cursor-blink {
    from {
      border-right-color: #fff;
    }
    to {
      border-right-color: transparent;
    }
  }

  #typewriter {
    --typewriter-animation-start: 3;
    --typewriter-animation-end: 10;
    --typewriter-animation-duration: 700ms;

    overflow: hidden;
    text-wrap: nowrap;
    text-overflow: clip;
    border-right: 2px solid #fff;

    width: calc(var(--typewriter-animation-end) * 1ch + 2px);
    animation:
      var(--typewriter-animation-duration, 1s)
        steps(
          calc(
            var(--typewriter-animation-end) - var(--typewriter-animation-start)
          )
        )
        typing,
      0.8s steps(2, jump-none) var(--typewriter-animation-duration, 1s) infinite
        cursor-blink;
  }

  /* This is the md breakpoint */
  @media (width >= 48rem) {
    #typewriter {
      --typewriter-animation-start: 21;
      --typewriter-animation-end: 34;
      --typewriter-animation-duration: 2.5s;
    }
  }
</style>

{/* Hero content */}
<div
  class="h-full grid grid-cols-5 grid-rows-(--rows-template) md:h-dvh md:grid-cols-12 md:grid-rows-4"
>
  <div
    class="col-span-5 row-start-2 md:row-start-2 md:col-span-8 md:row-span-2 md:self-center"
  >
    <p id="typewriter" class="font-mono mb-3 ml-1 text-gray-200">
      <span class="md:hidden"
        ><span class="text-blue-300">~# </span>./hello</span
      >
      <span class="hidden md:inline-block"
        ><span class="text-blue-300">root@kynsonszetau:~#{' '}</span
        >./hello_world</span
      >
    </p>
    <h1 class="text-3xl font-medium mb-11 sm:text-4xl lg:text-6xl">
      I am Kynson Szetau<br />A self-taught developer
    </h1>
    <a
      href="#projects"
      class="py-2 px-4 rounded-lg text-sm font-medium inline-block transition-safe-all bg-blue-50 text-gray-950 hover:brightness-95 focus:outline-offset-2 focus:outline-blue-100 focus:outline-2"
    >
      <span>Explore Projects <span class="font-mono">-></span></span>
    </a>
  </div>
  <ShadowLogo
    class="w-full col-start-4 row-start-3 col-span-2 row-span-1 justify-self-end md:col-start-9 md:row-start-2 md:col-span-3 md:row-span-3 md:self-center"
  />
</div>
