{
  "extends": ["../tsconfig.json", "astro/tsconfigs/strict"],
  "include": [
    ".astro/types.d.ts",
    "/@types/cloudflare-turnstile",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@content/*": ["./src/content/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"]
    }
  },
  "exclude": ["dist"],
  "references": [
    {
      "path": "../common"
    }
  ]
}