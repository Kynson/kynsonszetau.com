{
  "name": "kynsonszetau",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-14",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "kynsonszetau.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kynsonszetau.com",
      "custom_domain": true
    },
    {
      "pattern": "v3.kynsonszetau.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DYNAMIC_CONTENT",
      "id": "efb9d715af9b4d36ab74617a3c336df1"
    }
  ],
  "secrets": {
    "required": [
      "NOTIFICATION_WEBHOOK_URL",
      "TURNSTILE_SECRET",
      "TURNSTILE_SITEKEY"
    ]
  },
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
